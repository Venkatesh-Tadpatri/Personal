{
  "name": "ph",
  "version": "1.0.0",
  "description": "ph - Agricultural Trading Management System",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\" \"wait-on http://localhost:3000 && electron .\"",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.ph.agritrader",
    "productName": "PH AgriTrader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "database.js",
      "package.json",
      "client/build/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PH AgriTrader"
    }
  },
  "keywords": [
    "electron",
    "agri",
    "trader"
  ],
  "author": "ph",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sql.js": "^1.14.1"
  }
}
